{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./keys": "./src/keys.ts",
    "./generated/*": "./src/generated/*.ts"
  },
  "scripts": {
    "analyze": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "build": "prisma generate --no-hints --schema=./prisma/schema.prisma",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "db:push": "prisma format --schema=./prisma/schema.prisma && prisma generate --no-hints --schema=./prisma/schema.prisma && prisma db push --schema=./prisma/schema.prisma",
    "migrate": "prisma format --schema=./prisma/schema.prisma && prisma generate --no-hints --schema=./prisma/schema.prisma && prisma migrate dev --schema=./prisma/schema.prisma",
    "migrate:deploy": "prisma generate --no-hints --schema=./prisma/schema.prisma && prisma migrate deploy --schema=./prisma/schema.prisma",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@t3-oss/env-core": "^0.13.8",
    "prisma-zod-generator": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "dotenv": "^16.4.7",
    "prisma": "^7.9.1",
    "typescript": "^5"
  }
}
