{
  "name": "rrr3d",
  "version": "0.0.2",
  "description": "CLI to initialize rrr3d monorepo projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdelhamidaitayoub/rrr3d.git"
  },
  "type": "module",
  "bin": {
    "rrr3d": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:cli": "tsup",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/ui",
    "check": "ultracite check",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "migrate": "turbo run migrate --filter=@repo/db",
    "migrate:deploy": "turbo run migrate:deploy --filter=@repo/db",
    "prepare": "husky",
    "release": "npm publish",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^14.0.3",
    "nypm": "^0.6.5"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.5.6",
    "@hey-api/openapi-ts": "^0.99.0",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsup": "^8.5.1",
    "turbo": "^2.10.9",
    "typescript": "^5",
    "ultracite": "7.10.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
