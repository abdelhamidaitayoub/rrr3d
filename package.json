{
  "name": "turbox",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "bump-deps": "bunx npm-check-updates --deep -u && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/ui",
    "check": "ultracite check",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "migrate": "turbo run migrate --filter=@repo/db",
    "migrate:deploy": "turbo run migrate:deploy --filter=@repo/db",
    "prepare": "husky",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@hey-api/openapi-ts": "^0.99.0",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.9",
    "typescript": "^5",
    "ultracite": "7.10.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  }
}
